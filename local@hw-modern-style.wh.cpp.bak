// ==WindhawkMod==
// @id              hw-modern-style
// @name            HW-现代化样式
// @name:zh-CN      HW-现代化样式
// @description     Modernized shell UI bundle: modern Alt+Tab switcher, modern folder picker dialog, modern Run dialog, customizable context menu and a skinnable file-operation windows styler, merged into one mod.
// @description:zh-CN 现代化样式合集：整合现代 Alt+Tab 切换器、现代文件夹选择对话框、现代运行对话框、自定义右键菜单与文件操作样式（文件操作窗口换肤），各为一个分组、组首带总开关。
// @version         1.0.0
// @author          IMiloDev, aubymori, caotu2k5, BOLT, digART, Heptalune
// @license         GPL-3.0
// @include         *
// @exclude         crashpad_handler.exe
// @exclude         windhawk.exe
// @exclude         windhawk-ui.exe
// @architecture    x86-64
// @compilerOptions -lshell32 -lole32 -loleaut32 -lruntimeobject -lcomctl32 -lwindowsapp -luser32 -ldwmapi -lkernel32 -lgdi32 -lshlwapi -lversion -limm32 -lcomdlg32 -ld2d1 -ldwrite -ladvapi32 -luuid -luxtheme -ld3d11 -ldcomp -lpropsys -loleacc -ldxgi -lgdiplus -lmsimg32 -Wl,--export-all-symbols
// ==/WindhawkMod==
//
// HW-Beautify 汉化整合版本：把以下五个模组整合为一个，各自的代码、设置组与说明
// 文字随功能一并迁入；代码整体收入独立命名空间、入口改名为
// Init / AfterInit / BeforeUninit / Uninit / SettingsChanged，由文件末尾的统一
// 入口按进程分流调用：
//   1. HW-现代 Alt+Tab 切换器（hw-overhauled-alt-tab-inproc）→ AltTabSwitcher
//   2. HW-现代文件夹选择对话框（hw-modern-folder-picker）→ ModernFolderPicker
//   3. HW-现代运行对话框（hw-modern-run-dialog）→ ModernRunDialog
//   4. HW-自定义右键菜单（hw-custom-context-menu）→ ModernContextMenu
//   5. HW-更好的文件管理器的「文件操作样式（FileOpStyler）」→ FileOpStyler
// 进程门控：@include 为 *——「现代文件夹选择对话框」需在任意进程内接管旧式
// 「浏览文件夹」对话框；其余四组仅在 explorer.exe 中启用（入口按进程名分流）。

// ==WindhawkModSettings==
/*
- Appearance:
    - Scale: "100"
      $name: Scale
      $name:zh-CN: 缩放
      $description: Overall task switcher scale.
      $description:zh-CN: 任务切换器的整体缩放比例。
      $options:
      - "50": 50%
      - "75": 75%
      - "90": 90%
      - "100": 100%
      - "110": 110%
      - "125": 125%
    - PerformanceMode: "smooth"
      $name: Performance mode
      $name:zh-CN: 性能模式
      $description: Controls the animation update frequency.
      $description:zh-CN: 控制动画的刷新频率。
      $options:
      - "smooth": Smooth
      - "balanced": Balanced
      $options:zh-CN:
      - "smooth": 流畅
      - "balanced": 均衡
    - AnimationSpeed: "100"
      $name: Animation speed
      $name:zh-CN: 动画速度
      $description: Relative speed of the task switcher animations.
      $description:zh-CN: 任务切换器动画的相对速度。
      $options:
      - "75": 75%
      - "100": 100%
      - "125": 125%
      - "150": 150%
    - AnimationStyle: "Linear"
      $name: Animation style
      $name:zh-CN: 动画样式
      $description: Open and close animation. Linear is standard, Bouncy adds a pronounced bounce, and RCT is a CRT-style collapse and expansion.
      $description:zh-CN: 打开与关闭动画。Linear 为标准线性，Bouncy 带明显回弹，RCT 为 CRT 显像管式的收缩展开。
      $options:
      - "Linear": Linear
      - "Bouncy": Bouncy
      - "RCT": RCT
      $options:zh-CN:
      - "Linear": 线性
      - "Bouncy": 回弹
      - "RCT": RCT（CRT 复古）
    - Cards:
        - VisibleCards: "5"
          $name: Visible cards
          $name:zh-CN: 可见卡片数
          $description: Number of cards shown in the carousel.
          $description:zh-CN: 轮播中显示的卡片数量。
          $options:
          - "3": 3 cards
          - "5": 5 cards
          $options:zh-CN:
          - "3": 3 张卡片
          - "5": 5 张卡片
        - NormalColor: "#050507"
          $name: Cards color
          $name:zh-CN: 卡片颜色
          $description: Base color of the cards that are not selected. Default Hex - #050507. An empty or invalid value uses the default.
          $description:zh-CN: 未选中卡片的基础颜色。默认十六进制值 - #050507。留空或填无效值时使用默认值。
        - SelectedColor: "#090A0B"
          $name: Selected card color
          $name:zh-CN: 选中卡片颜色
          $description: Base color of the selected card. Default Hex - #090A0B. An empty or invalid value uses the default.
          $description:zh-CN: 选中卡片的基础颜色。默认十六进制值 - #090A0B。留空或填无效值时使用默认值。
        - ExpandSelectedWindow: true
          $name: Expand selected window
          $name:zh-CN: 展开所选窗口
          $description: Animates the selected card toward the selected window when confirmed.
          $description:zh-CN: 确认切换时，所选卡片以动画展开过渡到目标窗口。
      $name: Cards
      $name:zh-CN: 卡片
  $name: Appearance
  $name:zh-CN: 外观
- Background: "dwm"
  $name: Background
  $name:zh-CN: 背景
  $description: Background layer behind the cards.
  $description:zh-CN: 卡片背后的背景层。
  $options:
  - "none": None
  - "dwm": Transparent - DWM
  $options:zh-CN:
  - "none": 无
  - "dwm": 透明 - DWM
- Dwm:
    - BackgroundColor: "#141A22"
      $name: Background color
      $name:zh-CN: 背景颜色
      $description: Color of the transparent DWM background behind the cards. Default Hex - #141A22. An empty or invalid value uses the default.
      $description:zh-CN: 卡片背后透明 DWM 背景的颜色。默认十六进制值 - #141A22。留空或填无效值时使用默认值。
    - Opacity: 20
      $name: Opacity
      $name:zh-CN: 不透明度
      $description: DWM background opacity (0-100). Default - 20.
      $description:zh-CN: DWM 背景的不透明度（0-100）。默认 - 20。
  $name: DWM background
  $name:zh-CN: DWM 背景
- ExperimentalSettings:
    - GeneralBackground: "none"
      $name: General Background
      $name:zh-CN: 通用背景
      $description: Experimental features may require additional GPU, CPU and RAM resources and may affect performance. Pattern Waves requires a background other than None.
      $description:zh-CN: 实验性功能可能需要额外的 GPU、CPU 和内存资源，并可能影响性能。「图案波浪」需要把「背景」设为「无」以外的值。
      $options:
      - "none": None
      - "pattern": Pattern Waves
      $options:zh-CN:
      - "none": 无
      - "pattern": 图案波浪
    - PatternWaves:
        - Shape: "dots"
          $name: Shape
          $name:zh-CN: 形状
          $description: Pattern shape.
          $description:zh-CN: 图案的形状。
          $options:
          - "dots": Dots
          - "squares": Squares
          $options:zh-CN:
          - "dots": 圆点
          - "squares": 方块
        - Speed: 100
          $name: Speed
          $name:zh-CN: 速度
          $description: Procedural wave speed (0-200).
          $description:zh-CN: 程序化波浪的速度（0-200）。
        - WaveStrength: 65
          $name: Wave strength
          $name:zh-CN: 波浪强度
          $description: Surface deformation intensity (0-200).
          $description:zh-CN: 表面形变的强度（0-200）。
        - Density: 24
          $name: Density
          $name:zh-CN: 密度
          $description: Dot spacing (8-48).
          $description:zh-CN: 圆点的间距（8-48）。
        - Light: 120
          $name: Light
          $name:zh-CN: 光照
          $description: Apparent depth and illumination (0-200).
          $description:zh-CN: 视觉景深与光照强度（0-200）。
        - Contrast: 100
          $name: Contrast
          $name:zh-CN: 对比度
          $description: Dot contrast (0-200).
          $description:zh-CN: 圆点的对比度（0-200）。
        - Opacity: 100
          $name: Opacity
          $name:zh-CN: 不透明度
          $description: Pattern opacity (0-100).
          $description:zh-CN: 图案的不透明度（0-100）。
        - CursorInteraction: true
          $name: Cursor interaction
          $name:zh-CN: 光标交互
          $description: Enable cursor-driven ripples.
          $description:zh-CN: 启用由光标驱动的涟漪效果。
        - CursorStrength: 100
          $name: Cursor strength
          $name:zh-CN: 光标强度
          $description: Cursor ripple intensity (0-200).
          $description:zh-CN: 光标涟漪的强度（0-200）。
      $name: Pattern Waves
      $name:zh-CN: 图案波浪
  $name: Experimental
  $name:zh-CN: 实验性
- language: auto
  $name: Display · Language
  $name:zh-CN: 显示 · 界面语言
  $description: Auto-detect the system’s UI language or choose a fixed language.
  $description:zh-CN: 自动检测系统界面语言，或固定使用某种语言。
  $options:
  - auto: Auto – System Default
  - en: English
  - vi: Tiếng Việt (Vietnamese)
  - th: ไทย (Thai)
  - id: Bahasa Indonesia (Indonesian)
  - ms: Bahasa Melayu (Malay)
  - ja: 日本語 (Japanese)
  - zh_cn: 简体中文 (Simplified Chinese)
  - zh_tw: 繁體中文 (Traditional Chinese)
  - ko: 한국어 (Korean)
  - fr: Français (French)
  - de: Deutsch (German)
  - es: Español (Spanish)
  - pt: Português (Portuguese)
  - it: Italiano (Italian)
  - ru: Русский (Russian)
  - uk: Українська (Ukrainian)
  - pl: Polski (Polish)
  - nl: Nederlands (Dutch)
  - tr: Türkçe (Turkish)
  - hi: हिन्दी (Hindi)
  - ar: العربية (Arabic)
  $options:zh-CN:
  - auto: 自动（跟随系统）
  - en: 英语
  - vi: 越南语
  - th: 泰语
  - id: 印度尼西亚语
  - ms: 马来语
  - ja: 日语
  - zh_cn: 简体中文
  - zh_tw: 繁体中文
  - ko: 韩语
  - fr: 法语
  - de: 德语
  - es: 西班牙语
  - pt: 葡萄牙语
  - it: 意大利语
  - ru: 俄语
  - uk: 乌克兰语
  - pl: 波兰语
  - nl: 荷兰语
  - tr: 土耳其语
  - hi: 印地语
  - ar: 阿拉伯语
- surfaceTheme: glass
  $name: Appearance · Surface Theme
  $name:zh-CN: 外观 · 表面主题
  $description: Choose between Liquid Glass, Windows Blur, or Off – Opaque surface.
  $description:zh-CN: 选择液态玻璃、Windows 模糊，或关闭模糊（不透明背景）。
  $options:
  - glass: Liquid Glass
  - blur: Windows Blur
  - solid: Off – Opaque
  $options:zh-CN:
  - glass: 液态玻璃
  - blur: Windows 模糊
  - solid: 关闭（不透明）
- colorMode: auto
  $name: Appearance · Color Mode
  $name:zh-CN: 外观 · 明暗模式
  $description: Follow Windows’ Light/Dark mode and backdrop contrast automatically, or choose a fixed mode.
  $description:zh-CN: 自动跟随 Windows 的明暗模式与背景对比度，或固定使用某种模式。
  $options:
  - auto: Auto – Follow Windows
  - dark: Dark Mode
  - light: Light Mode
  $options:zh-CN:
  - auto: 自动（跟随 Windows）
  - dark: 深色模式
  - light: 浅色模式
- blurOpacity: 170
  $name: Appearance · Blur Opacity (0–255)
  $name:zh-CN: 外观 · 模糊底色浓度（0–255）
  $description: Background tint opacity when using Windows Blur (0–255, default is 170).
  $description:zh-CN: 使用 Windows 模糊时背景着色的不透明度（0–255，默认为 170）。
- enableAppSuggestions: true
  $name: Experimental · App Suggestions While Typing
  $name:zh-CN: 实验性 · 输入时建议应用
  $description: Suggest installed apps (Start Menu, App Paths) and system commands dynamically while typing — similar to PowerToys Run.
  $description:zh-CN: 输入时动态建议已安装的应用（开始菜单、App Paths）与系统命令 — 类似 PowerToys Run。
- maxHistoryItems: 5
  $name: History · Max Items (0–10)
  $name:zh-CN: 历史 · 最大条数（0–10）
  $description: Maximum number of recent commands or app suggestions shown in the top list (0–10, set 0 to disable).
  $description:zh-CN: 顶部列表显示的最近命令 / 应用建议最大条数（0–10，设为 0 可关闭）。
- showTimestamp: true
  $name: History · Show Last Executed Time
  $name:zh-CN: 历史 · 显示最近执行时间
  $description: Display the execution timestamp and clock icon on each history row — or hide both when disabled.
  $description:zh-CN: 在每条历史记录上显示执行时间与时钟图标；关闭后两者均隐藏。
- clearStoredHistory: false
  $name: History · Clear Stored History
  $name:zh-CN: 历史 · 清除已保存的历史
  $description: Turn on and save to clear the mod’s displayed history for the current user (without deleting Windows’ native RunMRU) — or press Delete on any row in the dialog.
  $description:zh-CN: 开启并保存即可清除当前用户在模组中显示的历史（不会删除 Windows 原生的 RunMRU）；也可在对话框中对任意一行按 Delete 键删除。
- clearInitialInput: true
  $name: Input · Clear Input on Open
  $name:zh-CN: 输入 · 打开时清空输入框
  $description: Show placeholder text on open — instead of pre-filling the last command.
  $description:zh-CN: 打开时显示占位提示文字，而不是预填上一次的命令。
- taskbarClickAction: minimize
  $name: Behavior · Taskbar Icon Click Action
  $name:zh-CN: 行为 · 任务栏图标点击动作
  $description: Action when clicking the Run icon on the Taskbar while open — minimize/restore or close.
  $description:zh-CN: 对话框处于打开状态时，点击任务栏上运行图标的动作 — 最小化/还原或关闭。
  $options:
  - minimize: Minimize – Restore
  - close: Close Window
  $options:zh-CN:
  - minimize: 最小化 / 还原窗口
  - close: 关闭窗口
- closeOnClickOutside: false
  $name: Behavior · Close on Click Outside
  $name:zh-CN: 行为 · 点击外部时关闭
  $description: Automatically close the Run dialog when clicking outside the window — similar to Command Palette.
  $description:zh-CN: 点击窗口外部时自动关闭运行对话框 — 类似命令面板。
- theme: "Custom (menu.ini)"
  $name: Theme
  $name:zh-CN: 主题
  $description: Loads the appearance from <storage>\themes\<name>.ini (created from the bundled preset on first use). menu.ini is never modified.
  $description:zh-CN: 从模组存储目录的 themes\<名称>.ini 加载外观（首次使用时由内置预设生成）；选择主题永远不会修改 menu.ini。
  $options:
  - Custom (menu.ini): 自定义（menu.ini）
  - Windows 11 Dark: Windows 11 深色
  - Windows 11 Light: Windows 11 浅色
  - Windows 10 Dark: Windows 10 深色
  - Windows 10 Light: Windows 10 浅色
  - Nord: Nord
  - Dracula: Dracula
  - Solarized Dark: Solarized 深色
  - Gruvbox Dark: Gruvbox 深色
  - One Dark: One Dark
  - Cyberpunk: 赛博朋克
  - Synthwave: 合成波
  - Terminal Green: 终端绿
  - Amber CRT: 琥珀 CRT
  - Tokyo Night: 东京之夜
  - AMOLED Black: AMOLED 纯黑
  - High Contrast: 高对比度
- menuMode: "custom"
  $name: Menu mode
  $name:zh-CN: 菜单模式
  $description: Custom draws the self-rendered menu and falls back to the classic menu after repeated failures. Classic always uses the owner-drawn menu.
  $description:zh-CN: 「自定义」绘制自绘菜单，多次失败后自动回退到经典菜单；「经典」始终使用系统自绘（owner-drawn）菜单。
  $options:
  - custom: 自定义（推荐）
  - classic: 经典自绘菜单
- enableShiftBypass: true
  $name: Bypass keys
  $name:zh-CN: 绕过按键
  $description: Hold Shift while right-clicking to bypass the mod and get the stock classic menu, or Ctrl for the untouched native menu.
  $description:zh-CN: 右键时按住 Shift 绕过本模组、显示原版经典菜单；按住 Ctrl 则显示完全未改动的系统原生菜单。
- instantMenuFade: true
  $name: Instant menu open
  $name:zh-CN: 菜单即时打开
  $description: Shows native fallback menus (classic mode, fallbacks) without the system open animation, via TPM_NOANIMATION.
  $description:zh-CN: 通过 TPM_NOANIMATION 让原生回退菜单（经典模式、回退场景）跳过系统打开动画。
- showMoreOptionsItem: true
  $name: Show classic menu item
  $name:zh-CN: 显示经典菜单项
  $description: Add a "Show classic menu" entry at the bottom of the replacement menu.
  $description:zh-CN: 在替换菜单底部添加一个「显示经典菜单」入口。
- topBar: false
  $name: Top action bar
  $name:zh-CN: 顶部操作栏
  $description: Moves Cut, Copy, Paste, Rename and Delete into an icon bar on the side of the menu nearest the cursor, like the Windows 11 menu. Custom menu mode only.
  $description:zh-CN: 把剪切、复制、粘贴、重命名和删除移到菜单靠光标一侧的图标栏上，类似 Windows 11 菜单。仅自定义菜单模式生效。
- submenuDelayMs: 150
  $name: Submenu open delay
  $name:zh-CN: 子菜单打开延迟
  $description: Milliseconds before a hovered submenu opens while the replacement menu is shown. 0 opens instantly; -1 keeps the Windows setting.
  $description:zh-CN: 显示替换菜单时，悬停多少毫秒后才打开子菜单。0 为立即打开；-1 保持 Windows 系统设置。
- advancedSubmenuWindows: true
  $name: Move Windows extras
  $name:zh-CN: 移动 Windows 附加项
  $description: Move the configured Windows extras into the More options submenu.
  $description:zh-CN: 把下方配置的 Windows 附加项移入「更多选项」子菜单。
- advancedSubmenuThirdParty: true
  $name: Move third-party handlers
  $name:zh-CN: 移动第三方处理程序
  $description: Move third-party shell extension entries into the More options submenu.
  $description:zh-CN: 把第三方 shell 扩展条目移入「更多选项」子菜单。
- advancedSubmenuItems: "Windows.ModernShare, pintohomefile, casttodevice, Give access to, PreviousVersions, pintostartscreen, pintohome, openterminal, setdesktopwallpaper"
  $name: Windows items to move
  $name:zh-CN: 要移动的 Windows 项目
  $description: Comma-separated labels or verbs of Windows items to move into the submenu. Verbs (for example setdesktopwallpaper) match on every language; labels match the menu's display language. GUID-verb commands also accept the aliases openterminal, editwithphotos, editwithpaint and editwithnotepad.
  $description:zh-CN: 逗号分隔的 Windows 项目标签或动词（verb），匹配到的项目会被移入子菜单。动词（如 setdesktopwallpaper）在任何语言下都能匹配；标签则按菜单显示语言匹配。GUID 动词命令还接受别名 openterminal、editwithphotos、editwithpaint、editwithnotepad。
- advancedSubmenuExclude: ""
  $name: Keep in the main menu
  $name:zh-CN: 保留在主菜单中
  $description: Comma-separated third-party labels or verbs that stay in the main menu instead of moving into the submenu.
  $description:zh-CN: 逗号分隔的第三方标签或动词，这些条目保留在主菜单、不移入子菜单。
- advancedSubmenuLabel: 更多选项
  $name: More options submenu label
  $name:zh-CN: 「更多选项」子菜单标签
  $description: Label of the submenu that collects extra items.
  $description:zh-CN: 收纳附加项的子菜单显示名称。
- settingsHotkey: ""
  $name: Settings hotkey
  $name:zh-CN: 设置热键
  $description: Optional global hotkey that opens the appearance settings menu (for example Ctrl+Alt+M). Empty disables it.
  $description:zh-CN: 可选的全局热键，按下即打开外观设置菜单（例如 Ctrl+Alt+M）。留空禁用。
- debugLogging: false
  $name: Debug logging
  $name:zh-CN: 调试日志
  $description: Log timing and diagnostics for troubleshooting.
  $description:zh-CN: 记录耗时与诊断信息，便于排查问题。
- clearCache: false
  $name: Clear cache
  $name:zh-CN: 清除缓存
  $description: Turn on to delete the cached menu models; they rebuild on next use.
  $description:zh-CN: 开启后删除已缓存的菜单模型，下次使用时自动重建。
- warmup: true
  $name: Background pre-build
  $name:zh-CN: 后台预构建
  $description: Warms common menus shortly after Explorer starts so their first open is instant. Turning it off skips loading every registered context-menu handler at startup (the stock menu's exposure), which avoids startup crashes from faulty third-party extensions; the first open of each context then builds on demand, like the stock menu. A handler that would crash the stock menu still crashes.
  $description:zh-CN: 资源管理器启动后稍等片刻预热常用菜单，使其首次打开即为即时。关闭后，启动时不再加载所有已注册的上下文菜单处理程序（与原版菜单相同的暴露面），可避免有缺陷的第三方扩展导致启动崩溃；此时每个上下文首次打开按需构建，与原版一致。若某个处理程序会让原版菜单崩溃，它仍然会崩溃。
- warmupExtensions: ".txt, .pdf, .zip, .rar, .7z, .jpg, .png, .mp4, .mp3, .docx, .xlsx, .exe, .lnk"
  $name: Warm-up extensions
  $name:zh-CN: 预热扩展名
  $description: Comma-separated file types whose menus are pre-built at Explorer startup.
  $description:zh-CN: 逗号分隔的文件类型列表，资源管理器启动时预构建这些类型的菜单。
- warmupDelaySeconds: 5
  $name: Warm-up delay
  $name:zh-CN: 预热延迟
  $description: Seconds to wait after Explorer starts before warming the cache.
  $description:zh-CN: 资源管理器启动后等待多少秒再开始预热缓存。

- fileOp:
  - enable: true
    $name: Enable this feature group
    $name:zh-CN: 启用本组功能
    $description: >-
      Master switch of the file operation presentation styling. Turning it off
      skips the whole group at load time.
    $description:zh-CN: >-
      「文件操作样式」分组总开关。关闭后在下次加载时跳过本组全部功能（修改后
      会触发整模组重载）。
  - showCurrentFileProgressBar: true
